  "prototype_source_utf8": "\"\"\"Track only tasks created in this workload's context, never unrelated tasks.\"\"\"\nimport asyncio\nfrom contextlib import contextmanager\nfrom contextvars import Context,ContextVar\n\n_owner=ContextVar('awaitlab_owned_tasks',default=None)\n\n\n@contextmanager\ndef owned_tasks():\n    loop=asyncio.get_running_loop()\n    tasks=set()\n    discard=tasks.discard\n    callback_context=Context()\n    previous=loop.get_task_factory()\n    token=_owner.set(tasks)\n    def factory(loop,coro,**kwargs):\n        context=kwargs.get('context')\n        owner=context.get(_owner) if context is not None else _owner.get()\n        task=previous(loop,coro,**kwargs) if previous else asyncio.Task(coro,loop=loop,**kwargs)\n        if owner is tasks and not task.done():\n            tasks.add(task)\n            task.add_done_callback(discard,context=callback_context)\n        return task\n    loop.set_task_factory(factory)\n    try:yield tasks\n    finally:\n        if loop.get_task_factory() is factory:loop.set_task_factory(previous)\n        _owner.reset(token)\n",
  "decision": "Not shipped: these separate protocol runs do not prove a general benefit over the simpler standard done-callback implementation"
